{
  "name": "@agent/desktop",
  "productName": "Aster",
  "description": "A local desktop AI agent workbench",
  "author": "Aster contributors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "pnpm run build && concurrently --kill-others-on-fail --success first --names build,electron --prefix-colors cyan,green \"tsup --watch\" \"node ../../scripts/electron-dev.mjs\"",
    "start": "pnpm dev",
    "preview": "node ../../scripts/electron-preview.mjs",
    "lint": "eslint src tsup.config.ts vitest.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm --filter @agent/protocol build && tsup"
  },
  "dependencies": {
    "@agent/protocol": "workspace:*",
    "@langchain/anthropic": "1.5.6",
    "@langchain/core": "1.2.8",
    "@langchain/google-genai": "2.2.0",
    "@langchain/langgraph": "1.4.10",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/openai": "1.5.8",
    "@vscode/ripgrep": "1.18.0",
    "@vue/compiler-sfc": "^3.5.44",
    "diff": "9.0.0",
    "esbuild": "0.27.7",
    "file-type": "^22.0.2",
    "jsonc-parser": "^3.3.1",
    "langchain": "1.5.9",
    "mammoth": "^1.12.1",
    "node-pty": "1.1.0",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.1",
    "vue": "^3.5.44",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
