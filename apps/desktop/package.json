{
  "name": "@agent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "pnpm run build && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "start": "electron .",
    "lint": "eslint src tsup.config.ts vitest.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm --filter @agent/protocol build && tsup"
  },
  "dependencies": {
    "@agent/protocol": "workspace:*",
    "@langchain/anthropic": "1.5.6",
    "@langchain/core": "1.2.8",
    "@langchain/google-genai": "2.2.0",
    "@langchain/langgraph": "1.4.10",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/openai": "1.5.8",
    "@vscode/ripgrep": "1.18.0",
    "diff": "9.0.0",
    "file-type": "^22.0.2",
    "langchain": "1.5.9",
    "mammoth": "^1.12.1",
    "parse5": "8.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
