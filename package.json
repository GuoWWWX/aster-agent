{
  "name": "agent-workbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,desktop --prefix-colors cyan,green \"pnpm --filter @agent/web dev\" \"wait-on tcp:127.0.0.1:5173 && pnpm --filter @agent/desktop dev\"",
    "lint": "pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "build": "pnpm --recursive --if-present run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "wait-on": "^9.1.0"
  }
}
